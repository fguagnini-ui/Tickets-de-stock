rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reportes/{reportId} {
      allow read, write: if true;
    }

    match /movimientos/{movementId} {
      allow read, write: if true;
    }

    match /meta/{metaId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
